# Required
QOBUZ_EMAIL=your@email.com
QOBUZ_PASSWORD=your_password

# Optional — auto-resolved from Qobuz's web bundle if not set
# QOBUZ_APP_ID=
# QOBUZ_APP_SECRET=

# --- Transport ---
QOBUZ_MCP_TRANSPORT=stdio          # stdio | http
# QOBUZ_MCP_HTTP_HOST=127.0.0.1
# QOBUZ_MCP_HTTP_PORT=8000
# QOBUZ_MCP_HTTP_BEARER_TOKEN=     # http auth fallback (machine-to-machine); openssl rand -hex 32

# --- OIDC / remote OAuth (for Claude apps; takes precedence over the bearer token) ---
# Set all four to enable. Register a confidential client on the IdP with redirect URI
# <OIDC_BASE_URL><OIDC_REDIRECT_PATH>.
# OIDC_CONFIG_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BASE_URL=https://qobuz.example.com
# OIDC_REDIRECT_PATH=/auth/callback
# OIDC_REQUIRED_SCOPES=            # optional, comma-separated
# OIDC_ALLOWED_REDIRECT_URIS=https://claude.ai/*,https://claude.com/*
# OIDC_VERIFY_ID_TOKEN=false       # true if the IdP issues opaque (non-JWT) access tokens
# OIDC_FORWARD_RESOURCE=false      # PocketID & many IdPs reject the RFC 8707 resource indicator

# --- Host/Origin guard (FastMCP DNS-rebinding protection) ---
# Only localhost is trusted by default → a proxied Host returns 421, so the guard is OFF
# by default for HTTP (run behind a TLS reverse proxy). Set true to harden.
# MCP_HOST_ORIGIN_PROTECTION=false
# MCP_ALLOWED_HOSTS=extra.example.com
# MCP_ALLOWED_ORIGINS=https://extra.example.com
